// Data Academy - Prisma Schema
// PostgreSQL database for the LMS platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  READING
  VIDEO_READING
  CODING_EXERCISE
  SQL_EXERCISE
  QUIZ
  ASSIGNMENT
  PROJECT
  DOWNLOADABLE
  EXTERNAL_RESOURCE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  CODE_CHALLENGE
  SQL_CHALLENGE
}

enum SubmissionStatus {
  PENDING
  GRADED
  RETURNED
}

enum NotificationType {
  ENROLLMENT
  ANNOUNCEMENT
  DEADLINE
  GRADE
  ASSESSMENT_RESULT
  COURSE_COMPLETE
  CERTIFICATE
  SYSTEM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── IDENTITY & ACCESS ───────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String
  role            Role      @default(STUDENT)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile               UserProfile?
  tutorProfile          TutorProfile?
  enrollments           Enrollment[]
  lessonProgress        LessonProgress[]
  bookmarks             Bookmark[]
  notes                 StudentNote[]
  submissions           AssignmentSubmission[]
  assessmentAttempts    AssessmentAttempt[]
  certificates          Certificate[]
  notifications         Notification[]
  announcements         Announcement[]        @relation("AnnouncementAuthor")
  supportTickets        SupportTicket[]
  auditLogs             AuditLog[]
  courseInstructors     CourseInstructor[]

  @@index([email])
  @@index([role])
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  avatar    String?
  bio       String?
  country   String?
  timezone  String?
  website   String?
  linkedin  String?
  twitter   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TutorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  headline      String?
  expertise     String[]
  biography     String?
  profileImage  String?
  isApproved    Boolean  @default(false)
  rating        Float    @default(0)
  totalStudents Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseInstructors CourseInstructor[]
}

// ─── COURSE CONTENT ──────────────────────────────────────────────────────────

model CourseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  courses     Course[]
}

model Course {
  id                  String       @id @default(cuid())
  title               String
  slug                String       @unique
  shortDescription    String
  fullDescription     String
  coverImage          String?
  categoryId          String?
  level               CourseLevel  @default(BEGINNER)
  estimatedHours      Float        @default(0)
  price               Float        @default(0)
  isFree              Boolean      @default(true)
  status              CourseStatus @default(DRAFT)
  isFeatured          Boolean      @default(false)
  prerequisites       String[]
  learningOutcomes    String[]
  tags                String[]
  certificateEnabled  Boolean      @default(false)
  completionThreshold Float        @default(0.8)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  category            CourseCategory?     @relation(fields: [categoryId], references: [id])
  modules             Module[]
  enrollments         Enrollment[]
  instructors         CourseInstructor[]
  learningPathCourses LearningPathCourse[]
  certificates        Certificate[]
  announcements       Announcement[]

  @@index([status])
  @@index([slug])
  @@index([isFeatured])
}

model CourseInstructor {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  tutorId   String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])
  tutor     TutorProfile? @relation(fields: [tutorId], references: [id])

  @@unique([courseId, userId])
}

model LearningPath {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  icon        String?
  color       String?
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses     LearningPathCourse[]
}

model LearningPathCourse {
  id             String   @id @default(cuid())
  learningPathId String
  courseId       String
  order          Int      @default(0)
  isRequired     Boolean  @default(true)

  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, courseId])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id                 String     @id @default(cuid())
  moduleId           String
  title              String
  type               LessonType @default(READING)
  order              Int        @default(0)
  isRequired         Boolean    @default(true)
  isPreview          Boolean    @default(false)
  estimatedMinutes   Int        @default(15)
  videoUrl           String?
  content            String?
  learningObjectives String[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources   LessonResource[]
  progress    LessonProgress[]
  bookmarks   Bookmark[]
  notes       StudentNote[]
  assessment  Assessment?
  assignment  Assignment?

  @@index([moduleId, order])
}

model LessonResource {
  id        String   @id @default(cuid())
  lessonId  String
  title     String
  type      String
  url       String
  size      Int?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─── LEARNING ─────────────────────────────────────────────────────────────────

model Enrollment {
  id           String           @id @default(cuid())
  userId       String
  courseId     String
  status       EnrollmentStatus @default(ACTIVE)
  progress     Float            @default(0)
  enrolledAt   DateTime         @default(now())
  completedAt  DateTime?
  lastAccessed DateTime?

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  isComplete     Boolean   @default(false)
  watchedSeconds Int       @default(0)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  note      String?
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model StudentNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─── ASSESSMENTS ─────────────────────────────────────────────────────────────

model Assessment {
  id             String   @id @default(cuid())
  lessonId       String   @unique
  title          String
  instructions   String?
  passingScore   Float    @default(70)
  timeLimitMins  Int?
  maxAttempts    Int      @default(3)
  randomizeOrder Boolean  @default(false)
  showResults    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lesson    Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]
}

model AssessmentQuestion {
  id             String       @id @default(cuid())
  assessmentId   String
  type           QuestionType @default(MULTIPLE_CHOICE)
  question       String
  explanation    String?
  order          Int          @default(0)
  points         Float        @default(1)
  codeTemplate   String?
  expectedOutput String?
  createdAt      DateTime     @default(now())

  assessment  Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options     AssessmentOption[]
  responses   AssessmentResponse[]
}

model AssessmentOption {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AssessmentAttempt {
  id            String    @id @default(cuid())
  userId        String
  assessmentId  String
  score         Float?
  isPassed      Boolean   @default(false)
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  timeTakenSecs Int?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment  Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  responses   AssessmentResponse[]

  @@index([userId, assessmentId])
}

model AssessmentResponse {
  id           String   @id @default(cuid())
  attemptId    String
  questionId   String
  selectedIds  String[]
  textAnswer   String?
  isCorrect    Boolean  @default(false)
  pointsEarned Float    @default(0)

  attempt    AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id])
}

model Assignment {
  id              String    @id @default(cuid())
  lessonId        String    @unique
  title           String
  description     String
  instructions    String
  rubric          String?
  maxScore        Float     @default(100)
  dueDate         DateTime?
  allowFileUpload Boolean   @default(true)
  allowText       Boolean   @default(true)
  allowCode       Boolean   @default(false)
  allowLink       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  content      String?
  fileUrl      String?
  codeContent  String?
  linkUrl      String?
  status       SubmissionStatus @default(PENDING)
  score        Float?
  feedback     String?
  gradedBy     String?
  gradedAt     DateTime?
  submittedAt  DateTime         @default(now())

  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([userId])
}

// ─── RECOGNITION & COMMUNICATION ────────────────────────────────────────────

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  certificateCode String   @unique @default(cuid())
  issuedAt        DateTime @default(now())
  verificationUrl String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String?
  authorId  String
  title     String
  content   String
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  author  User    @relation("AnnouncementAuthor", fields: [authorId], references: [id])
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String
  subject     String
  description String
  status      TicketStatus @default(OPEN)
  priority    String       @default("NORMAL")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── PLATFORM OPERATIONS ─────────────────────────────────────────────────────

model UploadedFile {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  uploadedBy   String?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  label     String?
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  studentName String
  avatar      String?
  content     String
  rating      Int      @default(5)
  courseTitle String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}
