# ─── DATABASE CONNECTION ────────────────────────────────────────────────────────
# DATABASE_URL: Transaction-pooled connection string (recommended for Vercel / serverless).
# E.g. Supabase port 6543 with ?pgbouncer=true&connect_timeout=30&pool_timeout=30
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30&pool_timeout=30"

# DIRECT_URL: Direct session connection string (used by Prisma CLI for migrations on port 5432).
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connect_timeout=30&pool_timeout=30"

# ─── SUPABASE SSR AUTHENTICATION ──────────────────────────────────────────────
# Public Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Public Supabase Anon API Key (safe for browser and public clients)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ─── APPLICATION URL ─────────────────────────────────────────────────────────
# Public canonical production URL (e.g., https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── ENVIRONMENT ─────────────────────────────────────────────────────────────
# Automatically managed by Vercel in production
NODE_ENV="development"
